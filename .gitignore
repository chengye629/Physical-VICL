# Upload whitelist: ignore everything by default.
*

# Repository metadata and documentation.
!.gitignore
!README.md
!requirements.txt

# Python package.
!src/
!src/**

# Command-line entry points and workflow placeholders.
!scripts/
scripts/*
!scripts/evaluate/
!scripts/evaluate/**
!scripts/prepare/
!scripts/prepare/**
!scripts/inference/
!scripts/inference/**

# Shareable examples only. Local config and manifest files remain ignored.
!configs/
configs/*
!configs/paths.example.yaml
!manifests/
manifests/*
!manifests/example.yaml

# Physics Card annotation and demonstration-retrieval workflow.
!physical_icl/
!physical_icl/**

# GPT-5.5 annotation results.
!results/
!results/**

# Generated Python cache must remain excluded inside whitelisted folders.
**/__pycache__/
*.pyc
