# Copy this file to config/local.env and edit for each machine.
# No path in this package assumes the original author's filesystem.

# Workspace containing data/, outputs/, logs/, etc.
PROJECT_ROOT=/path/to/your/Physical-ICL-workspace

# Local Qwen3-VL checkpoint. For the 32B experiment, point this to the 32B checkpoint.
QWEN_MODEL=/path/to/Qwen3-VL-32B-Instruct

# Optional: use different checkpoints for the two annotation stages.
# If unset, both default to QWEN_MODEL.
PASS_A_MODEL=
PASS_B_MODEL=


# Qwen3 Embedding checkpoint for retrieval.
EMBED_MODEL=/path/to/Qwen3-Embedding-8B

# A runtime manifest with video_path values valid on THIS machine.
MANIFEST=/path/to/runtime_manifest.jsonl

# Annotation output directory.
ANNOTATION_ROOT=/path/to/output/annotation_run

# GPU IDs for independent data-parallel annotation workers.
GPU_LIST="0 1 2 3"

# Qwen video sampling. These are the values used by the frozen v7 Pass A workflow.
FPS=8
MIN_FRAMES=32
MAX_FRAMES=64

# When 1, from_pretrained is local-only. Set 0 only if this machine is allowed to download models.
PHYSICL_LOCAL_FILES_ONLY=1

# Retrieval inputs/outputs after annotation.
CARDS_ROOT=/path/to/annotation_run/combined/cards
RETRIEVAL_ROOT=/path/to/output/retrieval_run
GPU=0
BATCH_SIZE=8
LANGUAGE_TOP_K=500
DEMO_COUNT=10
MMR_LAMBDA=0.85
TAU_LANGUAGE=0.84
TAU_PROCESS=0.55
TAU_PHYSICAL=0.55
